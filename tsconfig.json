/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "dom"],
    "baseUrl": "./",
    "paths": {
      "@shared/*": ["src/app/shared/*"],
      "@ui/*": ["src/app/ui/*"],
      "@modules/*": ["src/app/modules/*"],
      "@product/*": ["src/app/modules/product/*"],
      "@category/*": ["src/app/modules/category/*"],
      "@measurement-units/*": ["src/app/modules/measurement-units/*"],
      "@main-view/*": ["src/app/modules/main-view/*"],
      "@presentation/*": ["src/app/modules/presentation/*"],
      "@price-history/*": ["src/app/modules/price-history/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
